# Optional API Keys for Live LLM Research & Web Scraping
# The pipeline runs deterministically out-of-the-box without keys.
# Supply any of the following if live online dynamic synthesis is enabled:

# LLM Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Search / Scraping Providers (Optional)
TAVILY_API_KEY=
SERPER_API_KEY=

# Pipeline Configuration
RESEARCH_MODE=deterministic  # Options: deterministic, hybrid, live
CACHE_DIR=.cache
LOG_LEVEL=INFO
